<Window x:Class="SilentSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SilentSetup"
        mc:Ignorable="d"
        Title="Silent Setup" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Silent Setup" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Automated Windows Software Installer" FontSize="12" Foreground="#BDC3C7"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Làm mới" Width="80" Height="30" Margin="5,0" Click="RefreshButton_Click"/>
                    <Button x:Name="ToggleLogsButton" Content="Logs ❯" Width="80" Height="30" Margin="5,0" Click="ToggleLogsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar: Search, Filter, Sort -->
        <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="10" Background="#ECF0F1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box with Clear Button -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox" Height="30"
                             VerticalContentAlignment="Center"
                             Padding="5,0,30,0"
                             TextChanged="SearchTextBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Tìm kiếm app..." Foreground="Gray" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button x:Name="ClearSearchButton" Content="✕"
                            Width="25" Height="25"
                            HorizontalAlignment="Right"
                            Margin="0,0,3,0"
                            Click="ClearSearchButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Xóa tìm kiếm">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=Text}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Category Filter -->
                <ComboBox x:Name="CategoryFilterComboBox" Grid.Column="1" Width="150" Height="30" Margin="10,0,0,0"
                          SelectionChanged="CategoryFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                    <ComboBoxItem Content="Browser"/>
                    <ComboBoxItem Content="Development"/>
                    <ComboBoxItem Content="Media"/>
                    <ComboBoxItem Content="Utility"/>
                </ComboBox>

                <!-- Sort -->
                <ComboBox x:Name="SortComboBox" Grid.Column="2" Width="150" Height="30" Margin="10,0,0,0"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="Tên (A-Z)" IsSelected="True"/>
                    <ComboBoxItem Content="Tên (Z-A)"/>
                    <ComboBoxItem Content="Đã cài"/>
                    <ComboBoxItem Content="Chưa cài"/>
                    <ComboBoxItem Content="Category"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- App List -->
        <!-- Main Content Area with Log Panel -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="LogPanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- App List -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AppListPanel">
                    <TextBlock Text="Loading applications..." FontSize="14" Foreground="Gray" Margin="10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" x:Name="LogSplitter" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#BDC3C7" Visibility="Collapsed"/>

            <!-- Log Panel -->
            <Border Grid.Column="2" x:Name="LogPanel" BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log Header -->
                    <Border Grid.Row="0" Background="#34495E" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Logs" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="RefreshLogsButton" Content="⟳" Width="30" Height="25" Margin="2,0" Click="RefreshLogsButton_Click" ToolTip="Refresh logs"/>
                                <Button x:Name="ClearLogsButton" Content="✗" Width="30" Height="25" Margin="2,0" Click="ClearLogsButton_Click" ToolTip="Clear display"/>
                                <Button x:Name="OpenLogsFolderButton" Content="📁" Width="30" Height="25" Margin="2,0" Click="OpenLogsFolderButton_Click" ToolTip="Open logs folder"/>
                                <Button x:Name="HideLogsButton" Content="❯" Width="30" Height="25" Margin="2,0" Click="HideLogsButton_Click" ToolTip="Hide log panel"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Log Content -->
                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="5">
                        <TextBlock x:Name="LogTextBlock" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="#2C3E50"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <Border Grid.Row="3" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Padding="10" Background="#ECF0F1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Chọn tất cả" Width="110" Height="35" Margin="0,0,5,0" Click="SelectAllButton_Click"/>
                    <Button Content="Bỏ chọn" Width="110" Height="35" Margin="0,0,5,0" Click="DeselectAllButton_Click"/>
                </StackPanel>

                <!-- Right buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="AddAppButton" Content="Thêm App" Width="110" Height="35"
                            Click="AddAppButton_Click" Background="#3498DB" Foreground="White" Margin="0,0,5,0"/>
                    <Button x:Name="SettingsButton" Content="Cài đặt" Width="110" Height="35"
                            Click="SettingsButton_Click" Background="#95A5A6" Foreground="White" Margin="0,0,5,0"/>
                    <Button x:Name="InstallButton" Content="Cài đặt đã chọn" Width="140" Height="35"
                            Click="InstallButton_Click" FontWeight="Bold" Background="#27AE60" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar -->
        <Border Grid.Row="4" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <ProgressBar x:Name="ProgressBar" Height="20" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
