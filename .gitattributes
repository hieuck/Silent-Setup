# Auto detect text files and normalize line endings to LF in repository
* text=auto

# Source code
*.cs text diff=csharp
*.xaml text
*.yaml text
*.yml text
*.md text
*.json text

# Windows-specific files use CRLF
*.sln text eol=crlf
*.csproj text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
