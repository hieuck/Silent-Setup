# Auto detect text files and normalize line endings to LF in repository
* text=auto

# Force LF for specific text file types
*.cs text eol=lf
*.xaml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Force CRLF for Windows-specific files
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.rar binary
