<Window x:Class="SilentSetup.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Cài đặt ứng dụng" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Tabs -->
        <TabControl Grid.Row="1">
            <!-- Categories Tab -->
            <TabItem Header="Danh mục">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Quản lý danh mục ứng dụng:" Margin="0,0,0,10"/>

                    <ListBox x:Name="CategoryListBox" Grid.Row="1" Margin="0,0,0,10">
                        <ListBoxItem Content="Browser" Tag="default"/>
                        <ListBoxItem Content="Development" Tag="default"/>
                        <ListBoxItem Content="Media" Tag="default"/>
                        <ListBoxItem Content="Utility" Tag="default"/>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Thêm" Width="80" Height="30" Margin="0,0,5,0" Click="AddCategoryButton_Click"/>
                        <Button Content="Xóa" Width="80" Height="30" Margin="0,0,5,0" Click="RemoveCategoryButton_Click"/>
                        <TextBlock Text="(Danh mục mặc định không thể xóa)"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="Gray"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Download Tab -->
            <TabItem Header="Download">
                <StackPanel Margin="10">
                    <TextBlock Text="Thư mục cache:" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CacheDirTextBox" Grid.Column="0" Height="30" VerticalContentAlignment="Center" IsReadOnly="True" Text="cache"/>
                        <Button Grid.Column="1" Content="Chọn" Width="80" Height="30" Margin="5,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Timeout (giây):" Margin="0,0,0,5"/>
                    <TextBox x:Name="TimeoutTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15" Text="300"/>

                    <TextBlock Text="Số lần thử lại:" Margin="0,0,0,5"/>
                    <TextBox x:Name="RetriesTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15" Text="3"/>

                    <CheckBox x:Name="VerifyChecksumCheckBox" Content="Xác minh checksum khi download" IsChecked="True"/>
                </StackPanel>
            </TabItem>

            <!-- Patches Tab -->
            <TabItem Header="Patches">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh sách patches:" Margin="0,0,0,10"/>

                    <ListBox x:Name="PatchListBox" Grid.Row="1" Margin="0,0,0,10" SelectionMode="Single"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Chỉnh sửa" Width="100" Height="30" Margin="0,0,5,0" Click="EditPatchButton_Click"/>
                        <Button Content="Xóa patch" Width="100" Height="30" Margin="0,0,5,0" Click="DeletePatchButton_Click"/>
                        <Button Content="Mở thư mục" Width="100" Height="30" Margin="0,0,5,0" Click="OpenPatchFolderButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Help Tab -->
            <TabItem Header="Trợ giúp">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Hướng dẫn sử dụng" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="1. Cài đặt phần mềm:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            • Tick chọn app muốn cài<LineBreak/>
                            • Nhấn "Cài đặt đã chọn"<LineBreak/>
                            • Chờ quá trình download và cài đặt hoàn tất
                        </TextBlock>

                        <TextBlock Text="2. Thêm app mới:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            • Nhấn nút "Thêm App"<LineBreak/>
                            • Điền thông tin: tên, ID, category, URL download<LineBreak/>
                            • Nhấn "Lưu" để tạo manifest YAML
                        </TextBlock>

                        <TextBlock Text="3. Chỉnh sửa app:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            • Chuột phải vào app → "Chỉnh sửa"<LineBreak/>
                            • Sửa thông tin trong form<LineBreak/>
                            • Nhấn "Lưu" để cập nhật
                        </TextBlock>

                        <TextBlock Text="4. Patches:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            • Patches sẽ tự hiển thị nếu có trong thư mục patches/<LineBreak/>
                            • Tick chọn patch muốn áp dụng trước khi cài app<LineBreak/>
                            • Quản lý patches tại tab "Patches" trong Cài đặt
                        </TextBlock>

                        <TextBlock Text="5. Tìm kiếm và lọc:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            • Tìm kiếm: gõ tên app vào ô search<LineBreak/>
                            • Lọc theo category: chọn từ dropdown<LineBreak/>
                            • Sắp xếp: chọn tiêu chí sắp xếp
                        </TextBlock>

                        <TextBlock Text="Tài liệu chi tiết:" FontWeight="Bold" Margin="0,15,0,5"/>
                        <TextBlock Margin="0,0,0,5">
                            <Hyperlink NavigateUri="docs/USER_GUIDE.md" RequestNavigate="Hyperlink_RequestNavigate">
                                Xem hướng dẫn chi tiết
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,5">
                            <Hyperlink NavigateUri="docs/QUICK_START.md" RequestNavigate="Hyperlink_RequestNavigate">
                                Hướng dẫn thêm app/patch
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Update Tab -->
            <TabItem Header="Cập nhật">
                <StackPanel Margin="10">
                    <TextBlock Text="Kiểm tra cập nhật" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Border BorderBrush="#BDC3C7" BorderThickness="1" Padding="15" Margin="0,0,0,15" Background="#ECF0F1">
                        <StackPanel>
                            <TextBlock x:Name="CurrentVersionText" Text="Phiên bản hiện tại: 1.0.0" Margin="0,0,0,5"/>
                            <TextBlock x:Name="UpdateStatusText" Text="Chưa kiểm tra cập nhật" Margin="0,0,0,10" Foreground="Gray"/>
                            <Button x:Name="CheckUpdateButton" Content="Kiểm tra cập nhật" Width="150" Height="35"
                                    Click="CheckUpdateButton_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tự động cập nhật:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <CheckBox x:Name="AutoUpdateCheckBox" Content="Kiểm tra cập nhật khi khởi động" Margin="0,0,0,15"/>

                    <TextBlock Text="Kênh cập nhật:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="UpdateChannelComboBox" Height="30" Margin="0,0,0,15">
                        <ComboBoxItem Content="Stable (Ổn định)" IsSelected="True"/>
                        <ComboBoxItem Content="Beta (Thử nghiệm)"/>
                    </ComboBox>

                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11">
                        Lưu ý: Tính năng tự động cập nhật sẽ kiểm tra phiên bản mới từ GitHub repository.
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <!-- About Tab -->
            <TabItem Header="Thông tin">
                <StackPanel Margin="10">
                    <TextBlock Text="Silent Setup" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Version 1.0.0" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock Text="Automated Windows Software Installer" Margin="0,0,0,20"/>

                    <TextBlock Text="Tính năng:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="• Cài đặt tự động phần mềm" Margin="0,0,0,3"/>
                    <TextBlock Text="• Hỗ trợ patch và Việt hóa" Margin="0,0,0,3"/>
                    <TextBlock Text="• Quản lý app qua giao diện" Margin="0,0,0,3"/>
                    <TextBlock Text="• Không cần cài đặt (portable)" Margin="0,0,0,20"/>

                    <TextBlock Text="GitHub Repository:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Margin="0,0,0,15">
                        <Hyperlink NavigateUri="https://github.com/yourusername/silent-setup" RequestNavigate="Hyperlink_RequestNavigate">
                            https://github.com/yourusername/silent-setup
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="© 2026 Silent Setup Project" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="MIT License" Foreground="Gray" FontSize="11"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Lưu" Width="100" Height="35" Margin="0,0,10,0" Click="SaveButton_Click" IsDefault="True"/>
            <Button Content="Đóng" Width="100" Height="35" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
