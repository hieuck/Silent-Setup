<Window x:Class="SilentSetup.EditPatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa Patch" Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Chỉnh sửa Patch" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Info -->
                <TextBlock Text="Thông tin cơ bản" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Tên patch:"/>
                <TextBox x:Name="NameTextBox" Margin="0,5,0,15"/>

                <TextBlock Text="ID patch (không dấu, chữ thường):"/>
                <TextBox x:Name="IdTextBox" Margin="0,5,0,15" IsReadOnly="True" Background="#E0E0E0"/>

                <TextBlock Text="Áp dụng cho app (ID):"/>
                <TextBox x:Name="TargetAppTextBox" Margin="0,5,0,15"/>

                <!-- Patch Type -->
                <TextBlock Text="Loại patch" FontWeight="Bold" Margin="0,10,0,10"/>

                <ComboBox x:Name="PatchTypeComboBox" Margin="0,5,0,15" SelectionChanged="PatchTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="copy-files" Tag="copy-files"/>
                    <ComboBoxItem Content="executable" Tag="executable"/>
                    <ComboBoxItem Content="registry" Tag="registry"/>
                    <ComboBoxItem Content="extract-archive" Tag="extract-archive"/>
                </ComboBox>

                <!-- Copy Files Section -->
                <StackPanel x:Name="CopyFilesPanel" Visibility="Collapsed">
                    <TextBlock Text="Files cần copy" FontWeight="Bold" Margin="0,10,0,10"/>
                    <TextBlock Text="Đặt các file vào thư mục patches/[patch-id]/files/" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>

                    <TextBlock Text="Destination path (sử dụng {app_dir} cho thư mục app):"/>
                    <TextBox x:Name="DestinationTextBox" Margin="0,5,0,15" Text="{}{app_dir}"/>
                </StackPanel>

                <!-- Executable Section -->
                <StackPanel x:Name="ExecutablePanel" Visibility="Collapsed">
                    <TextBlock Text="Thực thi file" FontWeight="Bold" Margin="0,10,0,10"/>

                    <TextBlock Text="Tên file exe (trong thư mục files/):"/>
                    <TextBox x:Name="ExeFileTextBox" Margin="0,5,0,10"/>

                    <TextBlock Text="Arguments (tùy chọn):"/>
                    <TextBox x:Name="ExeArgsTextBox" Margin="0,5,0,15"/>
                </StackPanel>

                <!-- Registry Section -->
                <StackPanel x:Name="RegistryPanel" Visibility="Collapsed">
                    <TextBlock Text="Registry modifications" FontWeight="Bold" Margin="0,10,0,10"/>

                    <TextBlock Text="Root (HKCU, HKLM, etc):"/>
                    <TextBox x:Name="RegRootTextBox" Margin="0,5,0,10" Text="HKCU"/>

                    <TextBlock Text="Path:"/>
                    <TextBox x:Name="RegPathTextBox" Margin="0,5,0,10"/>

                    <TextBlock Text="Name:"/>
                    <TextBox x:Name="RegNameTextBox" Margin="0,5,0,10"/>

                    <TextBlock Text="Value:"/>
                    <TextBox x:Name="RegValueTextBox" Margin="0,5,0,10"/>

                    <TextBlock Text="Type (string, dword):"/>
                    <TextBox x:Name="RegTypeTextBox" Margin="0,5,0,15" Text="string"/>
                </StackPanel>

                <!-- Extract Archive Section -->
                <StackPanel x:Name="ExtractPanel" Visibility="Collapsed">
                    <TextBlock Text="Giải nén archive" FontWeight="Bold" Margin="0,10,0,10"/>

                    <TextBlock Text="Tên file archive (trong thư mục files/):"/>
                    <TextBox x:Name="ArchiveFileTextBox" Margin="0,5,0,10"/>

                    <TextBlock Text="Destination path:"/>
                    <TextBox x:Name="ExtractDestTextBox" Margin="0,5,0,10" Text="{}{app_dir}"/>

                    <TextBlock Text="Password (nếu có):"/>
                    <TextBox x:Name="ArchivePasswordTextBox" Margin="0,5,0,15"/>
                </StackPanel>

                <!-- Additional Info -->
                <TextBlock Text="Thông tin bổ sung" FontWeight="Bold" Margin="0,10,0,10"/>

                <TextBlock Text="Mô tả (tùy chọn):"/>
                <TextBox x:Name="DescriptionTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,15"/>

                <TextBlock Text="Thư mục patch:" Foreground="Gray" FontSize="11"/>
                <TextBlock x:Name="PatchDirectoryText" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Lưu" Width="100" Height="35" Margin="0,0,10,0" Click="SaveButton_Click" IsDefault="True"/>
            <Button Content="Hủy" Width="100" Height="35" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
