<Window x:Class="SilentSetup.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm ứng dụng mới" Height="550" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Thêm ứng dụng mới" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Info -->
                <TextBlock Text="Thông tin cơ bản" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Tên hiển thị:"/>
                <TextBox x:Name="NameTextBox" Margin="0,5,0,15"/>

                <TextBlock Text="ID (không dấu, chữ thường, dấu - thay khoảng trắng):"/>
                <TextBox x:Name="IdTextBox" Margin="0,5,0,15" TextChanged="IdTextBox_TextChanged"/>

                <TextBlock Text="Website chính thức:"/>
                <Grid Margin="0,5,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HomepageTextBox" Grid.Column="0"/>
                    <Button x:Name="AutoFillButton" Grid.Column="1" Content="Tự động điền" Width="100" Height="30"
                            Margin="5,0,0,0" Click="AutoFillButton_Click" Background="#3498DB" Foreground="White"/>
                </Grid>

                <!-- Download -->
                <TextBlock Text="Download" FontWeight="Bold" Margin="0,10,0,10"/>

                <TextBlock Text="Link download trực tiếp (HTTPS):"/>
                <TextBox x:Name="DownloadUrlTextBox" Margin="0,5,0,15"/>

                <!-- Install -->
                <TextBlock Text="Cài đặt" FontWeight="Bold" Margin="0,10,0,10"/>

                <TextBlock Text="Loại installer:"/>
                <ComboBox x:Name="InstallTypeComboBox" Margin="0,5,0,15" SelectedIndex="0">
                    <ComboBoxItem Content="exe"/>
                    <ComboBoxItem Content="msi"/>
                    <ComboBoxItem Content="zip"/>
                </ComboBox>

                <TextBlock Text="Tham số silent install:"/>
                <TextBox x:Name="SilentArgsTextBox" Margin="0,5,0,15"/>

                <!-- Detection -->
                <TextBlock Text="Phát hiện app đã cài" FontWeight="Bold" Margin="0,10,0,10"/>

                <TextBlock Text="Registry key (VD: HKLM\\SOFTWARE\\AppName):"/>
                <TextBox x:Name="RegistryKeyTextBox" Margin="0,5,0,10"/>

                <TextBlock Text="Hoặc đường dẫn file .exe:"/>
                <TextBox x:Name="FilePathTextBox" Margin="0,5,0,15"/>

                <!-- Metadata -->
                <TextBlock Text="Thông tin thêm" FontWeight="Bold" Margin="0,10,0,10"/>

                <TextBlock Text="Mô tả ngắn:"/>
                <TextBox x:Name="DescriptionTextBox" Margin="0,5,0,10"/>

                <TextBlock Text="Nhà phát hành:"/>
                <TextBox x:Name="PublisherTextBox" Margin="0,5,0,10"/>

                <TextBlock Text="Danh mục:"/>
                <ComboBox x:Name="CategoryComboBox" Margin="0,5,0,15" SelectedIndex="3">
                    <ComboBoxItem Content="Browser"/>
                    <ComboBoxItem Content="Development"/>
                    <ComboBoxItem Content="Media"/>
                    <ComboBoxItem Content="Utility"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Thêm" Width="100" Height="35" Margin="0,0,10,0" Click="AddButton_Click" IsDefault="True"/>
            <Button Content="Hủy" Width="100" Height="35" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
